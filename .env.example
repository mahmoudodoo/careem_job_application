# Copy to .env and fill in, or just export the variable in your shell.
# .env is gitignored; the toolkit reads the environment, not this file.

# Required only for live mode. Omit it and use --mock to run fully offline.
LLM_API_KEY=...

# Optional overrides (all have CLI flags too).
# CAREEM_PROMPTS_DIR=/absolute/path/to/prompts
